# Supabase / Lovable Cloud — copy real values from your Cloud project into .env
# Browser client (Vite build-time injection)
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_<your-key>"
VITE_SUPABASE_PROJECT_ID="<project-ref>"

# Server-side rendering fallback
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_<your-key>"
SUPABASE_PROJECT_ID="<project-ref>"

# Optional — only needed for admin/server-role operations (client.server.ts)
# SUPABASE_SERVICE_ROLE_KEY="sb_secret_<your-key>"

# Optional — only needed to run drizzle-kit migrations yourself
# LOVABLE_DB_MIGRATION_URL="postgresql://..."
